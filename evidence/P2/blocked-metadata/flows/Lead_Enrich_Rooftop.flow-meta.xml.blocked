<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Routes new leads by Ontario FSA prefix through Lead_Routing__mdt and assigns a round-robin owner lane. Honors Automation_Settings__c.Bypass_Flows__c.</description>
    <interviewLabel>Lead Enrich Rooftop</interviewLabel>
    <label>Lead Enrich Rooftop</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Should_Route</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PostalCode</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <formulas>
        <name>Postal_No_Spaces</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!$Record.PostalCode}, " ", "")</expression>
    </formulas>
    <formulas>
        <name>FSA_Prefix</name>
        <dataType>String</dataType>
        <expression>IF(LEFT({!Postal_No_Spaces}, 1) = "M", "M", IF(LEFT({!Postal_No_Spaces}, 1) = "L", LEFT({!Postal_No_Spaces}, 3), "UNROUTED"))</expression>
    </formulas>
    <formulas>
        <name>Bypass_Flows</name>
        <dataType>Boolean</dataType>
        <expression>{!$Setup.Automation_Settings__c.Bypass_Flows__c}</expression>
    </formulas>
    <variables>
        <name>Route_Match</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Lead_Routing__mdt</objectType>
    </variables>
    <variables>
        <name>Rooftop_Row</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Rooftop__c</objectType>
    </variables>
    <variables>
        <name>Lane_A_User</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>User</objectType>
    </variables>
    <variables>
        <name>Lane_B_Queue</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Group</objectType>
    </variables>
    <variables>
        <name>Owner_Lanes</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>RR_Slot</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>RR_Owner</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>RR_Batch</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <decisions>
        <name>Should_Route</name>
        <label>Should Route</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnector>
            <targetReference>No_Op</targetReference>
        </defaultConnector>
        <rules>
            <name>Route</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Bypass_Flows</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PostalCode</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Fallback_Queue</targetReference>
            </connector>
            <label>Route</label>
        </rules>
    </decisions>
    <recordLookups>
        <name>Get_Fallback_Queue</name>
        <label>Get Fallback Queue</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Route_Match</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Q_Inbound_Leads</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <outputReference>Lane_B_Queue</outputReference>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Route_Match</name>
        <label>Get Route Match</label>
        <locationX>176</locationX>
        <locationY>398</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Verify_Match</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FSA_Prefix__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>FSA_Prefix</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead_Routing__mdt</object>
        <outputReference>Route_Match</outputReference>
        <queriedFields>FSA_Prefix__c</queriedFields>
        <queriedFields>Rooftop__c</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>
    <decisions>
        <name>Verify_Match</name>
        <label>Verify Match</label>
        <locationX>176</locationX>
        <locationY>518</locationY>
        <defaultConnector>
            <targetReference>Mark_Unrouted</targetReference>
        </defaultConnector>
        <rules>
            <name>Has_Route</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Route_Match.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Rooftop_Row</targetReference>
            </connector>
            <label>Has Route</label>
        </rules>
    </decisions>
    <recordLookups>
        <name>Get_Rooftop_Row</name>
        <label>Get Rooftop Row</label>
        <locationX>176</locationX>
        <locationY>638</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Verify_Rooftop</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Route_Match.Rooftop__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Rooftop__c</object>
        <outputReference>Rooftop_Row</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>
    <decisions>
        <name>Verify_Rooftop</name>
        <label>Verify Rooftop</label>
        <locationX>176</locationX>
        <locationY>758</locationY>
        <defaultConnector>
            <targetReference>Mark_Unrouted</targetReference>
        </defaultConnector>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Rooftop_Row.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Lane_A_User</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <recordLookups>
        <name>Get_Lane_A_User</name>
        <label>Get Lane A User</label>
        <locationX>176</locationX>
        <locationY>878</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Build_Owner_Lanes</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Username</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>ngrep@northgate.demo</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <outputReference>Lane_A_User</outputReference>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>
    <assignments>
        <name>Build_Owner_Lanes</name>
        <label>Build Owner Lanes</label>
        <locationX>176</locationX>
        <locationY>998</locationY>
        <assignmentItems>
            <assignToReference>Owner_Lanes</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Lane_A_User.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Owner_Lanes</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Lane_B_Queue.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Next_Slot</targetReference>
        </connector>
    </assignments>
    <actionCalls>
        <name>Next_Slot</name>
        <label>Next Slot</label>
        <locationX>176</locationX>
        <locationY>1118</locationY>
        <actionName>LeadRoundRobin</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Apply_Route</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>fsaPrefix</name>
            <value>
                <elementReference>FSA_Prefix</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>ownerIds</name>
            <value>
                <elementReference>Owner_Lanes</elementReference>
            </value>
        </inputParameters>
        <outputParameters>
            <assignToReference>RR_Slot</assignToReference>
            <name>slot</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>RR_Owner</assignToReference>
            <name>ownerId</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>RR_Batch</assignToReference>
            <name>batch</name>
        </outputParameters>
    </actionCalls>
    <assignments>
        <name>Apply_Route</name>
        <label>Apply Route</label>
        <locationX>176</locationX>
        <locationY>1238</locationY>
        <assignmentItems>
            <assignToReference>$Record.Rooftop__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Rooftop_Row.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Assigned_Batch__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>RR_Batch</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>RR_Owner</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Mark_Unrouted</name>
        <label>Mark Unrouted</label>
        <locationX>376</locationX>
        <locationY>518</locationY>
        <assignmentItems>
            <assignToReference>$Record.Assigned_Batch__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>UNROUTED</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Lane_B_Queue.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>No_Op</name>
        <label>No Op</label>
        <locationX>376</locationX>
        <locationY>158</locationY>
        <assignmentItems>
            <assignToReference>RR_Batch</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>RR_Batch</elementReference>
            </value>
        </assignmentItems>
    </assignments>
</Flow>
