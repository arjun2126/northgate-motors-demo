        <fields>
            <name>txtAppraisalSavedConfirmation</name>
            <fieldText>&lt;p&gt;Trade-in appraisal saved.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Record: {!Get_Saved_Trade_In.Name}&lt;/p&gt;&lt;p&gt;Status: {!Get_Saved_Trade_In.Status__c}&lt;/p&gt;&lt;p&gt;Appraisal amount: {!Get_Saved_Trade_In.Appraisal_Amount__c}&lt;/p&gt;&lt;p&gt;Payoff amount: {!Get_Saved_Trade_In.Payoff_Amount__c}&lt;/p&gt;&lt;p&gt;Saved trade equity: {!Get_Saved_Trade_In.Trade_Equity__c}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The appraisal is complete. Trade-in acceptance and quote creation&lt;/p&gt;&lt;p&gt;are separate steps.&lt;/p&gt;</fieldText>
