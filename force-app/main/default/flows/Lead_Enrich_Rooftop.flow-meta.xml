<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Apply_Route</name>
        <label>Apply_Route</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Rooftop__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Rooftop.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Mark_Unrouted</name>
        <label>Mark_Unrouted</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Assigned_Batch__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>UNROUTED</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Mark_Unrouted_2</name>
        <label>Mark_Unrouted_2</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Assigned_Batch__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>UNROUTED</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Has_Route</name>
        <label>Has_Route</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Mark_Unrouted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Route_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Route</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Rooftop</targetReference>
            </connector>
            <label>Route Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Not_Bypassed</name>
        <label>Not Bypassed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Continue_Routing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Should_Run_Routing</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Route</targetReference>
            </connector>
            <label>Continue Routing</label>
        </rules>
    </decisions>
    <decisions>
        <name>Rooftop_Exists</name>
        <label>Rooftop_Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Mark_Unrouted_2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Rooftop_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Rooftop.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Apply_Route</targetReference>
            </connector>
            <label>Rooftop Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Should_Run_Routing</name>
        <dataType>Boolean</dataType>
        <expression>NOT({!$Permission.Bypass_Automation})</expression>
    </formulas>
    <formulas>
        <name>var_FSA_Prefix</name>
        <dataType>String</dataType>
        <expression>IF(
  LEFT(SUBSTITUTE({!$Record.PostalCode}, &quot; &quot;, &quot;&quot;), 1) = &quot;M&quot;,
  &quot;M&quot;,
  IF(
    AND(
      LEFT(SUBSTITUTE({!$Record.PostalCode}, &quot; &quot;, &quot;&quot;), 1) = &quot;L&quot;,
      LEN(SUBSTITUTE({!$Record.PostalCode}, &quot; &quot;, &quot;&quot;)) &gt;= 3
    ),
    LEFT(SUBSTITUTE({!$Record.PostalCode}, &quot; &quot;, &quot;&quot;), 3),
    &quot;UNROUTED&quot;
  )
)</expression>
    </formulas>
    <interviewLabel>Apply_Route {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead Enrich Rooftop</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Rooftop</name>
        <label>Get_Rooftop</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Rooftop_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Route.Rooftop__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Rooftop__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Route</name>
        <label>Get_Route</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Route</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>FSA_Prefix__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>var_FSA_Prefix</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead_Routing__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Not_Bypassed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PostalCode</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
