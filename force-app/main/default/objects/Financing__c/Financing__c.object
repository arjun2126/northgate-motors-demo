<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://www.force.com/2009/06/some-schema">
    <fields>
        <apiName>Name</apiName>
        <type>Text</type>
        <length>80</length>
        <isNameField>true</isNameField>
    </fields>
    <fields>
        <apiName>Opportunity__c</apiName>
        <type>Lookup</type>
        <relationshipName>Opportunity__c</relationshipName>
    </fields>
    <fields>
        <apiName>Applicant__c</apiName>
        <type>Lookup</type>
        <relationshipName>Contact</relationshipName>
    </fields>
    <fields>
        <apiName>Co_Signer__c</apiName>
        <type>Lookup</type>
        <relationshipName>Contact</relationshipName>
    </fields>
    <fields>
        <apiName>Vehicle__c</apiName>
        <type>Lookup</type>
        <relationshipName>Vehicle__c</relationshipName>
    </fields>
    <fields>
        <apiName>Status__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Previous_Status__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Amount_Financed__c</apiName>
        <type>Currency</type>
    </fields>
    <fields>
        <apiName>Down_Payment__c</apiName>
        <type>Currency</type>
    </fields>
    <fields>
        <apiName>Term_Months__c</apiName>
        <type>Number</type>
        <precision>3</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Annual_Rate__c</apiName>
        <type>Number</type>
        <precision>5</type>
        <scale>3</scale>
    </fields>
    <fields>
        <apiName>Credit_Tier__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Monthly_Payment__c</apiName>
        <type>Currency</type>
    </fields>
    <fields>
        <apiName>Total_Interest__c</apiName>
        <type>Currency</type>
    </fields>
    <fields>
        <apiName>Lender__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Application_Date__c</apiName>
        <type>Date</type>
    </fields>
    <fields>
        <apiName>Decision_Date__c</apiName>
        <type>Date</type>
    </fields>
    <fields>
        <apiName>Rate_Source__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Exception_Reason__c</apiName>
        <type>Text</type>
        <length>255</length>
    </fields>
    <fields>
        <apiName>Funded_Date__c</apiName>
        <type>Date</type>
    </fields>
    <fields>
        <apiName>Payment_Calc_Help__c</apiName>
        <type>Formula>
            <formula>Text</formula>
        </Formula>
    </fields>
    <fields>
        <apiName>Seed_Tag__c</apiName>
        <type>Text</type>
        <length>80</length>
    </fields>
    <deploymentStatus>DeployedActive</deploymentStatus>
    <label>Financing</label>
    <pluralLabel>Financings</label>
</CustomObject>