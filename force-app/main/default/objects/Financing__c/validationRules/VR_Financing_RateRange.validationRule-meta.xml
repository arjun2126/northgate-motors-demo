<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Financing_RateRange</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($Permission.Bypass_Automation), OR(Annual_Rate__c &lt; 0, Annual_Rate__c &gt; 25))</errorConditionFormula>
    <errorDisplayField>Annual_Rate__c</errorDisplayField>
    <errorMessage>Annual rate must be between 0% and 25%.</errorMessage>
</ValidationRule>
