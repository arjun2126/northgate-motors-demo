<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Financing_FundedRequiresApproved</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($Permission.Bypass_Automation), ISPICKVAL(Status__c, &quot;Funded&quot;), NOT(ISPICKVAL(Previous_Status__c, &quot;Approved&quot;)))</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>Funded status is only allowed after the deal was Approved.</errorMessage>
</ValidationRule>
