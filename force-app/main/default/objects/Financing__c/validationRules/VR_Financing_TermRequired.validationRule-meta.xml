<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Financing_TermRequired</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($Permission.Bypass_Automation), NOT(ISPICKVAL(Status__c, &quot;Draft&quot;)), ISBLANK(Term_Months__c))</errorConditionFormula>
    <errorDisplayField>Term_Months__c</errorDisplayField>
    <errorMessage>Term is required once the financing record leaves Draft status.</errorMessage>
</ValidationRule>
