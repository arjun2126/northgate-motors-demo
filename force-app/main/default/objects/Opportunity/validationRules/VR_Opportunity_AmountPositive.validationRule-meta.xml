<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Opportunity_AmountPositive</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($Permission.Bypass_Automation), NOT(ISPICKVAL(StageName, &quot;Prospecting&quot;)), Amount &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Amount</errorDisplayField>
    <errorMessage>Opportunity amount must be greater than zero after Prospecting.</errorMessage>
</ValidationRule>
