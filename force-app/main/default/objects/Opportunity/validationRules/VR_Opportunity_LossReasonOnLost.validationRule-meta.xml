<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Opportunity_LossReasonOnLost</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($Permission.Bypass_Automation), ISPICKVAL(StageName, &quot;Closed Lost&quot;), ISPICKVAL(Loss_Reason__c, &quot;&quot;))</errorConditionFormula>
    <errorDisplayField>Loss_Reason__c</errorDisplayField>
    <errorMessage>Loss reason is required when opportunity is Closed Lost.</errorMessage>
</ValidationRule>
