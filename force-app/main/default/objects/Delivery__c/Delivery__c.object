<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://www.force.com/2009/06/some-schema">
    <fields>
        <apiName>Name</apiName>
        <type>Text</type>
        <length>80</length>
        <isNameField>true</isNameField>
    </fields>
    <fields>
        <apiName>Opportunity__c</apiName>
        <type>Lookup</type>
        <relationshipName>Opportunity__c</relationshipName>
    </fields>
    <fields>
        <apiName>Vehicle__c</apiName>
        <type>Lookup</type>
        <relationshipName>Vehicle__c</relationshipName>
    </fields>
    <fields>
        <apiName>Buyer__c</apiName>
        <type>Lookup</type>
        <relationshipName>Contact</relationshipName>
    </fields>
    <fields>
        <apiName>Status__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Scheduled_Date__c</apiName>
        <type>Date</type>
    </fields>
    <fields>
        <apiName>Completed_Date__c</apiName>
        <type>Date</type>
    </fields>
    <fields>
        <apiName>Delivered_By__c</apiName>
        <type>Lookup</type>
        <relationshipName>User</relationshipName>
    </fields>
    <fields>
        <apiName>Checklist_Documents__c</apiName>
        <type>Checkbox</type>
    </fields>
    <fields>
        <apiName>Checklist_Inspection__c</apiName>
        <type>Checkbox</type>
    </fields>
    <fields>
        <apiName>Checklist_Walkthrough__c</apiName>
        <type>Checkbox</type>
    </fields>
    <fields>
        <apiName>Checklist_Signature__c</apiName>
        <type>Checkbox</type>
    </fields>
    <fields>
        <apiName>Checklist_Complete__c</apiName>
        <type>FormulaCheckbox>
            <formula>AND(Checklist_Documents__c = TRUE, Checklist_Inspection__c = TRUE, Checklist_Walkthrough__c = TRUE, Checklist_Signature__c = TRUE)</formula>
        </FormulaCheckbox>
    </fields>
    <fields>
        <apiName>Accessories__c</apiName>
        <type>MultiPicklist</type>
    </fields>
    <fields>
        <apiName>Customer_Notes__c</apiName>
        <type>LongTextArea>
            <length>1000</length>
        </LongTextArea>
    </fields>
    <fields>
        <apiName>Seed_Tag__c</apiName>
        <type>Text</type>
        <length>80</length>
    </fields>
    <deploymentStatus>DeployedActive</deploymentStatus>
    <label>Delivery</label>
    <pluralLabel>Deliveries</label>
</CustomObject>