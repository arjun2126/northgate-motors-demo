<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_TradeIn_EquityInputs</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($Permission.Bypass_Automation), ISPICKVAL(Status__c, &quot;Accepted&quot;), OR(ISBLANK(Payoff_Amount__c), ISBLANK(Appraisal_Amount__c)))</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>Payoff and appraisal amount are required before accepting a trade-in.</errorMessage>
</ValidationRule>
