<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://www.force.com/2009/06/some-schema">
    <fields>
        <apiName>Name</apiName>
        <type>Text</type>
        <length>80</length>
        <isNameField>true</isNameField>
    </fields>
    <fields>
        <apiName>Opportunity__c</apiName>
        <type>Lookup</type>
        <relationshipName>Opportunity__c</relationshipName>
    </fields>
    <fields>
        <apiName>Contact__c</apiName>
        <type>Lookup</type>
        <relationshipName>Contact</relationshipName>
    </fields>
    <fields>
        <apiName>Trade_VIN__c</apiName>
        <type>Text</type>
        <length>17</length>
    </fields>
    <fields>
        <apiName>Trade_Year__c</apiName>
        <type>Number</type>
    </fields>
    <fields>
        <apiName>Trade_Make__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Trade_Model__c</apiName>
        <type>Text</type>
    </fields>
    <fields>
        <apiName>Trade_Odometer__c</apiName>
        <type>Number</type>
        <precision>7</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Trade_Condition__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Has_Structural_Damage__c</apiName>
        <type>Checkbox</type>
    </fields>
    <fields>
        <apiName>Status__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Appraisal_Amount__c</apiName>
        <type>Currency</type>
    </fields>
    <fields>
        <apiName>Payoff_Amount__c</apiName>
        <type>Currency</type>
    </fields>
    <fields>
        <apiName>Trade_Equity__c</apiName>
        <type>Formula>
            <formula>Appraisal_Amount__c - Payoff_Amount__c</formula>
        </Formula>
    </fields>
    <fields>
        <apiName>Appraised_By__c</apiName>
        <type>Lookup</type>
        <relationshipName>User</relationshipName>
    </fields>
    <fields>
        <apiName>Appraisal_Date__c</apiName>
        <type>Date</type>
    </fields>
    <fields>
        <apiName>Reconditioning_Cost__c</apiName>
        <type>Currency</type>
    </fields>
    <fields>
        <apiName>Wholesale_Value__c</apiName>
        <type>Currency</type>
    </fields>
    <fields>
        <apiName>Seed_Tag__c</apiName>
        <type>Text</type>
        <length>80</length>
    </fields>
    <deploymentStatus>DeployedActive</deploymentStatus>
    <label>Trade-In</label>
    <pluralLabel>Trade-Ins</label>
</CustomObject>