<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://www.force.com/2009/06/some-schema">
    <fields>
        <apiName>Name</apiName>
        <type>Text>
            <length>80</length>
        </Text>
    </fields>
    <fields>
        <apiName>Role__c</apiName>
        <type>Picklist>
            <value>Sales_Rep</value>
            <value>Sales_Manager</value>
            <value>Finance</value>
            <value>Service_Advisor</value>
            <value>Technician</value>
            <value>Inventory</value>
        </Picklist>
    </fields>
    <fields>
        <apiName>Rooftop__c</apiName>
        <type>Lookup>
            <relationshipName>Rooftop__c</relationshipName>
        </Lookup>
    </fields>
    <fields>
        <apiName>Is_Active__c</apiName>
        <type>Checkbox>
        </fields>
    </fields>
    <fields>
        <apiName>Hire_Date__c</apiName>
        <type>Date>
        </fields>
    </fields>
    <fields>
        <apiName>User__c</apiName>
        <type>Lookup>
            <relationshipName>User</relationshipName>
        </Lookup>
    </fields>
    <fields>
        <apiName>Username__c</apiName>
        <type>Text>
            <length>80</length>
        </Text>
    </fields>
    <fields>
        <apiName>Is_Persona_Login__c</apiName>
        <type>Checkbox>
        </fields>
    </fields>
    <fields>
        <apiName>Seed_Tag__c</apiName>
        <type>Text>
            <length>80</length>
        </Text>
    </fields>
    <deploymentStatus>DeployedActive</deploymentStatus>
    <label>Staff</label>
    <pluralLabel>Staff</label>
</CustomObject>