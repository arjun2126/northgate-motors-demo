<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://www.force.com/2009/06/some-schema">
    <fields>
        <apiName>Name</apiName>
        <type>Text</type>
        <length>80</length>
        <isNameField>true</isNameField>
    </fields>
    <fields>
        <apiName>Vehicle__c</apiName>
        <type>Lookup</type>
        <relationshipName>Vehicle__c</relationshipName>
    </fields>
    <fields>
        <apiName>Contact__c</apiName>
        <type>Lookup</type>
        <relationshipName>Contact</relationshipName>
    </fields>
    <fields>
        <apiName>Opportunity__c</apiName>
        <type>Lookup</type>
        <relationshipName>Opportunity__c</relationshipName>
    </fields>
    <fields>
        <apiName>Rooftop__c</apiName>
        <type>Lookup</type>
        <relationshipName>Rooftop__c</relationshipName>
    </fields>
    <fields>
        <apiName>Scheduled_Start__c</apiName>
        <type>DateTime</type>
    </fields>
    <fields>
        <apiName>Duration_Minutes__c</apiName>
        <type>Number</type>
        <precision>3</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Scheduled_End__c</apiName>
        <type>Formula>
            <formula>Scheduled_Start__c + Duration</formula>
        </Formula>
    </fields>
    <fields>
        <apiName>Status__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Assigned_To__c</apiName>
        <type>Lookup</type>
        <relationshipName>User</relationshipName>
    </fields>
    <fields>
        <apiName>Odometer_Start__c</apiName>
        <type>Number</type>
        <precision>7</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Odometer_End__c</apiName>
        <type>Number</type>
        <precision>7</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Route__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Feedback__c</apiName>
        <type>LongTextArea>
            <length>1000</length>
        </LongTextArea>
    </fields>
    <fields>
        <apiName>Customer_Score__c</apiName>
        <type>Number</type>
        <precision>2</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Purchase_Intent__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Outcome__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Seed_Tag__c</apiName>
        <type>Text</type>
        <length>80</length>
    </fields>
    <deploymentStatus>DeployedActive</deploymentStatus>
    <label>Test Drive</label>
    <pluralLabel>Test Drives</label>
</CustomObject>