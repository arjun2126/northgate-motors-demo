<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://www.force.com/2009/06/some-schema">
    <fields>
        <apiName>Name</apiName>
        <type>Text</type>
        <length>80</length>
        <isNameField>true</isNameField>
    </fields>
    <fields>
        <apiName>Address__c</apiName>
        <type>Text>
            <length>255</length>
        </Text>
    </fields>
    <fields>
        <apiName>City__c</apiName>
        <type>Text>
            <length>80</length>
        </Text>
    </fields>
    <fields>
        <apiName>Province__c</apiName>
        <type>Picklist>
            <value>ON</value>
            <value>QC</value>
            <value>BC</value>
            <value>AB</value>
            <value>MB</value>
        </Picklist>
    </fields>
    <fields>
        <apiName>Postal_Code__c</apiName>
        <type>Text>
            <length>10</length>
        </Text>
    </fields>
    <fields>
        <apiName>Type__c</apiName>
        <type>Picklist>
            <value>New_Sales</value>
            <value>Used_Sales</value>
            <value>Service_Center</value>
            <value>Full_Service</value>
        </Picklist>
    </fields>
    <fields>
        <apiName>General_Manager__c</apiName>
        <type>Lookup>
            <relationshipName>User</relationshipName>
        </Lookup>
    </fields>
    <fields>
        <apiName>Service_Capacity__c</apiName>
        <type>Number>
            <precision>4</type>
            <scale>0</scale>
        </Num>
    </fields>
    <fields>
        <apiName>Is_Active__c</apiName>
        <type>Checkbox>
        </fields>
    </fields>
    <fields>
        <apiName>Vehicles_On_Hand__c</apiName>
        <type>Number>
            <precision>6</type>
            <scale>0</scale>
        </Num>
    </fields>
    <deploymentStatus>DeployedActive</deploymentStatus>
    <label>Rooftop</label>
    <pluralLabel>Rooftops</label>
</CustomObject>