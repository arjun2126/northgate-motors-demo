<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://www.force.com/2009/06/some-schema">
    <fields>
        <apiName>Name</apiName>
        <type>Text</type>
        <length>80</length>
        <isNameField>true</isNameField>
    </fields>
    <fields>
        <apiName>Vehicle__c</apiName>
        <type>Lookup</type>
        <relationshipName>Vehicle__c</relationshipName>
    </fields>
    <fields>
        <apiName>Contact__c</apiName>
        <type>Lookup</type>
        <relationshipName>Contact</relationshipName>
    </fields>
    <fields>
        <apiName>Case__c</apiName>
        <type>Lookup</type>
        <relationshipName>Case</relationshipName>
    </fields>
    <fields>
        <apiName>Rooftop__c</apiName>
        <type>Lookup</type>
        <relationshipName>Rooftop__c</relationshipName>
    </fields>
    <fields>
        <apiName>Service_Type__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Status__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Scheduled_Start__c</apiName>
        <type>DateTime</type>
    </fields>
    <fields>
        <apiName>Duration_Minutes__c</apiName>
        <type>Number</type>
        <precision>3</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Advisor_Staff__c</apiName>
        <type>Lookup</type>
        <relationshipName>Staff__c</relationshipName>
    </fields>
    <fields>
        <apiName>Technician_Staff__c</apiName>
        <type>Lookup</type>
        <relationshipName>Staff__c</relationshipName>
    </fields>
    <fields>
        <apiName>RO_Number__c</apiName>
        <type>Text</type>
        <length>20</length>
    </fields>
    <fields>
        <apiName>Mileage_At_Checkin__c</apiName>
        <type>Number</type>
        <precision>7</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Work_Performed__c</apiName>
        <type>LongTextArea>
            <length>2000</length>
        </LongTextArea>
    </fields>
    <fields>
        <apiName>Labour_Hours__c</apiName>
        <type>Number</type>
        <precision>4</type>
        <scale>1</scale>
    </fields>
    <fields>
        <apiName>Parts_Cost__c</apiName>
        <type>Currency</type>
    </fields>
    <fields>
        <apiName>Labour_Cost__c</apiName>
        <type>Currency</type>
    </fields>
    <fields>
        <apiName>Total_Cost__c</apiName>
        <type>Formula>
            <formula>Parts_Cost__c + Labour_Cost__c</formula>
        </Formula>
    </fields>
    <fields>
        <apiName>Is_Overdue__c</apiName>
        <type>FormulaCheckbox>
            <formula>AND(Status <> 'Completed', Status <> 'Cancelled', Status <> 'No_Show', Scheduled_Start__c < NOW())</formula>
        </FormulaCheckbox>
    </fields>
    <fields>
        <apiName>Days_Overdue__c</apiName>
        <type>Formula>
            <formula>TODAY() - Scheduled_Start__c</formula>
        </Formula>
    </fields>
    <fields>
        <apiName>CSI_Score__c</apiName>
        <type>Number</type>
        <precision>2</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Follow_Up_Required__c</apiName>
        <type>Checkbox</type>
    </fields>
    <fields>
        <apiName>Seed_Tag__c</apiName>
        <type>Text</type>
        <length>80</length>
    </fields>
    <deploymentStatus>DeployedActive</deploymentStatus>
    <label>Service Visit</label>
    <pluralLabel>Service Visits</label>
</CustomObject>