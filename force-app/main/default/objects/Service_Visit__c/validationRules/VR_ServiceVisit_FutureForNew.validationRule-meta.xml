<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_ServiceVisit_FutureForNew</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($Permission.Bypass_Automation), ISPICKVAL(Status__c, &quot;Scheduled&quot;), Scheduled_Start__c &lt;= NOW())</errorConditionFormula>
    <errorDisplayField>Scheduled_Start__c</errorDisplayField>
    <errorMessage>Scheduled start must be in the future for new service visits.</errorMessage>
</ValidationRule>
