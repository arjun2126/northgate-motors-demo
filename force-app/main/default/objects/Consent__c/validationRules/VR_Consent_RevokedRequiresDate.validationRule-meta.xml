<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Consent_RevokedRequiresDate</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($Permission.Bypass_Automation), ISPICKVAL(Status__c, &quot;Revoked&quot;), ISBLANK(Revoked_On__c))</errorConditionFormula>
    <errorDisplayField>Revoked_On__c</errorDisplayField>
    <errorMessage>Revoked date is required when status is Revoked.</errorMessage>
</ValidationRule>
