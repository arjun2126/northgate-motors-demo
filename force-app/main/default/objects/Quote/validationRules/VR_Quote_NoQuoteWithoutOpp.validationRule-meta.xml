<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Quote_NoQuoteWithoutOpp</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($Permission.Bypass_Automation), ISBLANK(OpportunityId))</errorConditionFormula>
    <errorDisplayField>OpportunityId</errorDisplayField>
    <errorMessage>Quote must be associated with an opportunity.</errorMessage>
</ValidationRule>
