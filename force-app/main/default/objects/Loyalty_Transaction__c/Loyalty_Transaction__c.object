<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://www.force.com/2009/06/some-schema">
    <fields>
        <apiName>Name</apiName>
        <type>Text</type>
        <length>80</length>
        <isNameField>true</isNameField>
    </fields>
    <fields>
        <apiName>Member__c</apiName>
        <type>Lookup</type>
        <relationshipName>Loyalty_Member__c</relationshipName>
    </fields>
    <fields>
        <apiName>Type__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Points__c</apiName>
        <type>Number</type>
        <precision>8</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Reason__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Source_Reference__c</apiName>
        <type>Text</type>
        <length>80</length>
    </fields>
    <fields>
        <apiName>Transaction_Date__c</apiName>
        <type>Date</type>
    </fields>
    <fields>
        <apiName>Expiry_Date__c</apiName>
        <type>Date</type>
    </fields>
    <fields>
        <apiName>Is_Expired__c</apiName>
        <type>FormulaCheckbox>
            <formula></formula>
        </FormulaCheckbox>
    </fields>
    <fields>
        <apiName>Opportunity__c</apiName>
        <type>Lookup</type>
        <relationshipName>Opportunity__c</relationshipName>
    </fields>
    <fields>
        <apiName>Service_Visit__c</apiName>
        <type>Lookup</type>
        <relationshipName>Service_Visit__c</relationshipName>
    </fields>
    <fields>
        <apiName>Seed_Tag__c</apiName>
        <type>Text</type>
        <length>80</length>
    </fields>
    <deploymentStatus>DeployedActive</deploymentStatus>
    <label>Loyalty Transaction</label>
    <pluralLabel>Loyalty Transactions</label>
</CustomObject>