<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Loyalty_NonNegativeBalance</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($Permission.Bypass_Automation), Points_Balance__c &lt; 0)</errorConditionFormula>
    <errorDisplayField>Points_Balance__c</errorDisplayField>
    <errorMessage>Loyalty points balance cannot be negative.</errorMessage>
</ValidationRule>
