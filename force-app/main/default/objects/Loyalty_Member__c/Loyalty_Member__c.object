<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://www.force.com/2009/06/some-schema">
    <fields>
        <apiName>Name</apiName>
        <type>Text</type>
        <length>80</length>
        <isNameField>true</isNameField>
    </fields>
    <fields>
        <apiName>Contact__c</apiName>
        <type>Lookup</type>
        <relationshipName>Contact</relationshipName>
    </fields>
    <fields>
        <apiName>Member_Number__c</apiName>
        <type>Text</type>
        <length>12</length>
    </fields>
    <fields>
        <apiName>Status__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Tier__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Points_Balance__c</apiName>
        <type>Number</type>
        <precision>9</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Lifetime_Points_Earned__c</apiName>
        <type>Number</type>
        <precision>9</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Lifetime_Points_Redeemed__c</apiName>
        <type>Number</type>
        <precision>9</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Lifetime_Spend__c</apiName>
        <type>Currency</type>
    </fields>
    <fields>
        <apiName>Join_Date__c</apiName>
        <type>Date</type>
    </fields>
    <fields>
        <apiName>Last_Activity_Date__c</apiName>
        <type>Date</type>
    </fields>
    <fields>
        <apiName>Tier_Evaluated_On__c</apiName>
        <type>Date</type>
    </fields>
    <fields>
        <apiName>Next_Tier_Threshold__c</apiName>
        <type>Number</type>
        <precision>9</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Has_Expiring_Points__c</apiName>
        <type>FormulaCheckbox>
            <formula>Points_Balance__c < 0</formula>
        </FormulaCheckbox>
    </fields>
    <fields>
        <apiName>Seed_Tag__c</apiName>
        <type>Text</type>
        <length>80</length>
    </fields>
    <deploymentStatus>DeployedActive</deploymentStatus>
    <label>Loyalty Member</label>
    <pluralLabel>Loyalty Members</label>
</CustomObject>