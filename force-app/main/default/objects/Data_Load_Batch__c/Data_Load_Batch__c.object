<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://www.force.com/2009/06/some-schema">
    <fields>
        <apiName>Name</apiName>
        <type>Text</type>
        <length>80</length>
        <isNameField>true</isNameField>
    </fields>
    <fields>
        <apiName>Batch_Number__c</apiName>
        <type>Number</type>
        <precision>3</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Seed_Version__c</apiName>
        <type>Text</type>
        <length>20</length>
    </fields>
    <fields>
        <apiName>Object__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Inserted_Count__c</apiName>
        <type>Number</type>
        <precision>6</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Failed_Count__c</apiName>
        <type>Number</type>
        <precision>6</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Loaded_At__c</apiName>
        <type>DateTime</type>
    </fields>
    <fields>
        <apiName>Reset_At__c</apiName>
        <type>DateTime</type>
    </fields>
    <fields>
        <apiName>Status__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Notes__c</apiName>
        <type>LongTextArea>
            <length>1000</length>
        </LongTextArea>
    </fields>
    <deploymentStatus>DeployedActive</deploymentStatus>
    <label>Data Load Batch</label>
    <pluralLabel>Data Load Batches</label>
