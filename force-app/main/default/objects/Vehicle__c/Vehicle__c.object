<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://www.force.com/2009/06/some-schema">
    <fields>
        <apiName>Name</apiName>
        <type>Text</type>
        <length>80</length>
        <isNameField>true</isNameField>
    </fields>
    <fields>
        <apiName>VIN__c</apiName>
        <type>Text</type>
        <length>17</length>
    </fields>
    <fields>
        <apiName>Is_VIN_Valid__c</apiName>
        <type>Checkbox</type>
    </fields>
    <fields>
        <apiName>Model__c</apiName>
        <type>Lookup</type>
        <relationshipName>Vehicle_Model__c</relationshipName>
    </fields>
    <fields>
        <apiName>Year__c</apiName>
        <type>Number</type>
        <precision>4</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Colour__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>Status__c</apiName>
        <type>Picklist</type>
    </fields>
    <fields>
        <apiName>List_Price__c</apiName>
        <type>Currency</type>
    </fields>
    <fields>
        <apiName>MSRP__c</apiName>
        <type>Currency</type>
    </fields>
    <fields>
        <apiName>Invoice_Cost__c</apiName>
        <type>Currency</type>
    </fields>
    <fields>
        <apiName>Acquisition_Date__c</apiName>
        <type>Date</type>
    </fields>
    <fields>
        <apiName>Inventory_Age_Days__c</apiName>
        <type>Formula>
            <formula>TODAY() - Acquisition_Date__c</formula>
        </Formula>
    </fields>
    <fields>
        <apiName>Is_Aged_60__c</apiName>
        <type>FormulaCheckbox>
            <formula>Inventory_Age_Days__c > 60</formula>
        </FormulaCheckbox>
    </fields>
    <fields>
        <apiName>Rooftop__c</apiName>
        <type>Lookup</type>
        <relationshipName>Rooftop__c</relationshipName>
    </fields>
    <fields>
        <apiName>Lot_Stall__c</apiName>
        <type>Text</type>
        <length>10</length>
    </fields>
    <fields>
        <apiName>Mileage_at_Intake__c</apiName>
        <type>Number</type>
        <precision>7</type>
        <scale>0</scale>
    </fields>
    <fields>
        <apiName>Is_Demo_Unit__c</apiName>
        <type>Checkbox</type>
    </fields>
    <fields>
        <apiName>Reserved_By__c</apiName>
        <type>Lookup</type>
        <relationshipName>Contact</relationshipName>
    </fields>
    <fields>
        <apiName>Reserved_On__c</apiName>
        <type>DateTime</type>
    </fields>
    <fields>
        <apiName>Seed_Tag__c</apiName>
        <type>Text</type>
        <length>80</length>
    </fields>
    <deploymentStatus>DeployedActive</deploymentStatus>
    <label>Vehicle</label>
    <pluralLabel>Vehicles</label>
</CustomObject>