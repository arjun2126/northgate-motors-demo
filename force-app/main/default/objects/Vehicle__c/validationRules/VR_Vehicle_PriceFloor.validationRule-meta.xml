<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Vehicle_PriceFloor</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT($Permission.Bypass_Automation), List_Price__c &lt; Invoice_Cost__c)</errorConditionFormula>
    <errorDisplayField>List_Price__c</errorDisplayField>
    <errorMessage>List price cannot be below invoice cost.</errorMessage>
</ValidationRule>
