<?xml version="1.0" encoding="UTF-8" ?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingOwnerRules>
        <fullName>Contact_Service_Manager_Read</fullName>
        <sharedTo>
            <role>Service_Manager</role>
        </sharedTo>
        <sharedFrom>
            <allInternalUsers>AllInternalUsers</allInternalUsers>
        </sharedFrom>
        <accessLevel>Read</accessLevel>
        <label>Service Manager Contact Read</label>
        <description>Read-only Contact access for Service Manager so service leadership can see customers.</description>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>Contact_Service_Advisor_Read</fullName>
        <sharedTo>
            <roleAndSubordinatesInternal>Service_Advisor</roleAndSubordinatesInternal>
        </sharedTo>
        <sharedFrom>
            <allInternalUsers>AllInternalUsers</allInternalUsers>
        </sharedFrom>
        <accessLevel>Read</accessLevel>
        <label>Service Advisor Contact Read</label>
        <description>Read-only Contact access for Service Advisors and their subordinates (DATA_MODEL 6.4 option b).</description>
    </sharingOwnerRules>
</SharingRules>
