<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>IF(AND(CDF1:SUM &lt;= 24, Executive_Service_Metrics__c.CSI_Response_Count__c:SUM &gt; 0), Executive_Service_Metrics__c.CSI_Score_Total__c:SUM / Executive_Service_Metrics__c.CSI_Response_Count__c:SUM, NULL)</calculatedFormula>
        <datatype>number</datatype>
        <developerName>FORMULA1</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Current CSI Average</masterLabel>
        <scale>2</scale>
    </aggregates>
    <columns><field>Executive_Service_Metrics__c$Name</field></columns>
    <columns><aggregateTypes>Sum</aggregateTypes><field>Executive_Service_Metrics__c$CSI_Score_Total__c</field></columns>
    <columns><aggregateTypes>Sum</aggregateTypes><field>Executive_Service_Metrics__c$CSI_Response_Count__c</field></columns>
    <columns><field>Executive_Service_Metrics__c$Captured_At__c</field></columns>
    <columns><aggregateTypes>Sum</aggregateTypes><field>CDF1</field></columns>
    <customDetailFormulas>
        <calculatedFormula>(NOW() - Executive_Service_Metrics__c.Captured_At__c) * 24</calculatedFormula>
        <dataType>Double</dataType>
        <developerName>CDF1</developerName>
        <label>Capture Age Hours (over 24 is stale)</label>
        <scale>2</scale>
    </customDetailFormulas>
    <description>CSI score total divided by scored-response count. No responses or a capture older than 24 hours returns blank (N/A), never a fabricated zero average.</description>
    <filter>
        <criteriaItems><column>Executive_Service_Metrics__c$Metric_Key__c</column><operator>equals</operator><value>DEALERSHIP</value></criteriaItems>
        <language>en_US</language>
    </filter>
    <format>Summary</format>
    <groupingsDown><dateGranularity>None</dateGranularity><field>Executive_Service_Metrics__c$Metric_Key__c</field><sortOrder>Asc</sortOrder></groupingsDown>
    <name>Executive Service CSI</name>
    <reportType>ExecutiveServiceMetrics__c</reportType>
    <scope>organization</scope>
    <showDetails>true</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter><dateColumn>Executive_Service_Metrics__c$Captured_At__c</dateColumn><interval>INTERVAL_CUSTOM</interval></timeFrameFilter>
</Report>
